{
  "permissions": {
    "allow": [
      "Bash(node -e \"JSON.parse\\(require\\('fs'\\).readFileSync\\('content/games.json','utf8'\\)\\); console.log\\('games.json OK'\\)\")",
      "Bash(node --check js/games.js)",
      "Bash(node --check js/game-detail.js)",
      "Bash(python -m http.server 5555 --bind 127.0.0.1)",
      "Bash(curl -s -o /dev/null -w \"HTTP %{http_code}\\\\n\" http://127.0.0.1:5555/games.html)",
      "Bash(curl -s -o /dev/null -w \"HTTP %{http_code}\\\\n\" http://127.0.0.1:5555/game-detail.html)",
      "Bash(curl -s -o /dev/null -w \"HTTP %{http_code}\\\\n\" http://127.0.0.1:5555/content/games.json)",
      "Bash(curl -s -o /dev/null -w \"HTTP %{http_code}\\\\n\" http://127.0.0.1:5555/js/games.js)",
      "Bash(curl -s -o /dev/null -w \"HTTP %{http_code}\\\\n\" http://127.0.0.1:5555/js/game-detail.js)",
      "Bash(curl -s -o /dev/null -w \"HTTP %{http_code}\\\\n\" http://127.0.0.1:5555/css/games.css)",
      "Bash(curl -s -o /dev/null -w \"HTTP %{http_code}\\\\n\" http://127.0.0.1:5555/css/game-detail.css)",
      "Bash(curl -s -o /dev/null -w \"HTTP %{http_code}\\\\n\" http://127.0.0.1:5555/js/edit-mode.js)",
      "Bash(pkill -f \"http.server 5555\")"
    ]
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true
  }
}
